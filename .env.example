POSTGRES_USER=frostpoint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frostpoint
JWT_SECRET=generate-a-long-random-string
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@frostpoint.ph
SEED_ADMIN_PASSWORD=change-me-now
SEED_DEMO=true
WEB_PORT=8088

# Free key from openrouteservice.org for road routes and ETA on the tracking map (optional)
ORS_API_KEY=

# AML ERP API credentials: backend only. Use the origin, without /app or filters.
ERP_BASE_URL=https://erp.amlgroupofcompanies.com
ERP_API_KEY=
ERP_API_SECRET=
# AML Network requisitions belong to Frostpoint.
ERP_REQUISITION_PREFIX=FRP-
ERP_REQUISITION_CREATE_ENABLED=false
ERP_DPO_CREATE_ENABLED=false
# Keep false until ERP Write permissions and the intended environment are confirmed.
ERP_REQUISITION_WRITES_ENABLED=false
